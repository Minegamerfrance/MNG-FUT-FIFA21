[Unit]
Description=MNG FUT 21 private backend
Wants=network-online.target
After=network-online.target docker.service tailscaled.service
Requires=docker.service tailscaled.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/ubuntu/mng21-server/hosting
EnvironmentFile=/home/ubuntu/mng21-server/hosting/.env
ExecStartPre=/bin/sh -c 'for attempt in $(seq 1 60); do test "$(/usr/bin/tailscale ip -4 2>/dev/null)" = "$MNG21_BIND_ADDRESS" && exit 0; sleep 1; done; exit 1'
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=90

[Install]
WantedBy=multi-user.target
